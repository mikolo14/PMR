@using Microsoft.AspNetCore.Components.Web
@using System.Net.Mail

@if (AwaitingEmailConfirmation)
{
    <p class="auth-intro">Check <strong>@ConfirmationEmail</strong> for the confirmation link. After confirming, return here and sign in with your username and password.</p>
    <button class="text-link" type="button" @onclick="OnBackToSignIn">Back to sign in</button>
}
else
{
    @if (!string.IsNullOrWhiteSpace(DisplayedError))
    {
        <div class="auth-feedback" role="alert">@DisplayedError</div>
    }

    <form class="auth-form signup-form" autocomplete="off" novalidate @onsubmit="SubmitAsync" @onsubmit:preventDefault>
        <div class="signup-field">
            <label for="signup-name">Full name</label>
            <input id="signup-name" name="name" placeholder="Your full name" autocomplete="off" autocorrect="off" spellcheck="false" autocapitalize="off" required @bind="Name" @bind:event="onchange" />
        </div>
        <div class="signup-field">
            <label for="signup-username">Username</label>
            <input id="signup-username" name="username" placeholder="Choose a username" autocomplete="off" autocorrect="off" spellcheck="false" autocapitalize="off" required minlength="3" maxlength="30" pattern="[A-Za-z0-9][A-Za-z0-9._-]{2,29}" @bind="Username" @bind:event="onchange" />
        </div>
        <div class="signup-field">
            <label for="signup-email">Email address</label>
            <input id="signup-email" name="email" type="email" placeholder="you@example.com" autocomplete="off" autocorrect="off" spellcheck="false" autocapitalize="off" required @bind="Email" @bind:event="onchange" />
        </div>
        <div class="signup-field">
            <label for="signup-phone">Phone number <small>(optional)</small></label>
            <input id="signup-phone" name="tel" type="tel" placeholder="080 1234 5678" autocomplete="off" autocorrect="off" spellcheck="false" autocapitalize="off" @bind="Phone" @bind:event="onchange" />
        </div>
        <div class="signup-field password-field">
            <label for="signup-password">Password</label>
            <input id="signup-password" name="new-password" type="@(ShowPassword ? "text" : "password")" placeholder="Create a password" autocomplete="off" autocorrect="off" spellcheck="false" autocapitalize="off" required minlength="8" @bind="Password" @bind:event="onchange" />
            <button class="password-toggle" type="button" aria-label="@(ShowPassword ? "Hide password" : "Show password")" @onclick="() => ShowPassword = !ShowPassword">
                @if (ShowPassword)
                {
                    <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M2 12s3.5-6 10-6 10 6 10 6-3.5 6-10 6-10-6-10-6Z"/><circle cx="12" cy="12" r="3"/><path d="m4 4 16 16"/></svg>
                }
                else
                {
                    <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M2 12s3.5-6 10-6 10 6 10 6-3.5 6-10 6-10-6-10-6Z"/><circle cx="12" cy="12" r="3"/></svg>
                }
            </button>
        </div>
        <button class="primary-button wide" type="submit" disabled="@IsSubmitting">@(IsSubmitting ? "Creating account…" : "Create account") @if (!IsSubmitting) { <span>→</span> }</button>
        <small class="form-hint">Confirm your email to activate sign-in. No SMS verification is used. Membership becomes active after your first payment.</small>
    </form>
    <div class="auth-switch">Already a member? <button type="button" @onclick="OnBackToSignIn">Sign in</button></div>
}

@code {
    [Parameter] public bool AwaitingEmailConfirmation { get; set; }
    [Parameter] public string ConfirmationEmail { get; set; } = string.Empty;
    [Parameter] public EventCallback<Submission> OnSubmit { get; set; }
    [Parameter] public string? ErrorMessage { get; set; }
    [Parameter] public EventCallback OnBackToSignIn { get; set; }

    private string Name { get; set; } = string.Empty;
    private string Username { get; set; } = string.Empty;
    private string Email { get; set; } = string.Empty;
    private string Phone { get; set; } = string.Empty;
    private string Password { get; set; } = string.Empty;
    private bool ShowPassword { get; set; }
    private bool IsSubmitting { get; set; }
    private string? ValidationError { get; set; }
    private string? DisplayedError => ValidationError ?? ErrorMessage;

    private async Task SubmitAsync()
    {
        if (IsSubmitting) return;
        ValidationError = ValidateForm();
        if (ValidationError is not null) return;

        IsSubmitting = true;
        await InvokeAsync(StateHasChanged);
        try
        {
            await OnSubmit.InvokeAsync(new Submission(Name, Username, Email, Phone, Password));
        }
        finally
        {
            IsSubmitting = false;
        }
    }

    private string? ValidateForm()
    {
        if (string.IsNullOrWhiteSpace(Name)) return "Enter your full name.";

        var username = Username.Trim();
        if (username.Length is < 3 or > 30 || !char.IsAsciiLetterOrDigit(username[0]) ||
            username.Any(c => !char.IsAsciiLetterOrDigit(c) && c is not '.' and not '_' and not '-'))
            return "Use a username with 3–30 letters, numbers, dots, underscores or hyphens; start with a letter or number.";

        var email = Email.Trim();
        if (!MailAddress.TryCreate(email, out var address) || !string.Equals(address.Address, email, StringComparison.OrdinalIgnoreCase))
            return "Enter a valid email address.";

        if (Password.Length < 8) return "Your password must be at least 8 characters.";
        return null;
    }

    public sealed record Submission(string Name, string Username, string Email, string Phone, string Password);
}
